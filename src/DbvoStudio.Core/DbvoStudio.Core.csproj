<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DbvoStudio.Core</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fomod\ModuleConfig.xsd" LogicalName="DbvoStudio.Core.Fomod.ModuleConfig.xsd" />
    <None Include="Fomod\ModuleConfig.xsd.LICENSE.txt" />
    <EmbeddedResource Include="Reference\uesp-skyrim.json.gz" LogicalName="DbvoStudio.Core.Reference.uesp-skyrim.json.gz" />
    <EmbeddedResource Include="Reference\voicetype-templates.txt" LogicalName="DbvoStudio.Core.Reference.voicetype-templates.txt" />
    <EmbeddedResource Include="Books\Sets\*.json.gz" LogicalName="DbvoStudio.Core.Books.Sets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Grunts\Data\*.json.gz" LogicalName="DbvoStudio.Core.Grunts.Data.%(Filename)%(Extension)" />
    <None Include="Reference\README.md" />
    <None Include="Reference\extract_uesp.py" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
  </ItemGroup>

</Project>
