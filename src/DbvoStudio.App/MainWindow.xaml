<Window x:Class="DbvoStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DBVO Voice Pack Studio" Height="900" Width="1500" MinWidth="1000" MinHeight="600"
        Background="#16141A" WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#16141A" />
        <TextBlock x:Name="Loading" Text="Starting…" Foreground="#9A93A6" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
